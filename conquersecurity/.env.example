# Copy this file to .env in the project root and fill in real values.
# .env is gitignored — never commit real credentials.

# ── Cloudinary (image uploads) ──────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── SMTP (lead notification emails, sent via Gmail) ─────────
# SMTP_EMAIL / SMTP_PASSWORD = the Gmail account sending the mail.
# SMTP_PASSWORD must be a 16-character Gmail "App Password", not your
# normal Google account password. Generate one at:
# https://myaccount.google.com/apppasswords
SMTP_EMAIL=
SMTP_PASSWORD=

# Where lead notification emails should actually be delivered.
LEAD_TO_EMAIL=
LEAD_TO_NAME=Conquer Services
